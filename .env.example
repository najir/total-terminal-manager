# Local secrets for this project — read by Env.Load() in utility.cs.
#
#   - Put REAL values here. This file is git-ignored and must never be committed,
#     pasted into source, or shared in chat/tickets.
#   - This file is PLAINTEXT. It keeps secrets out of the repo; it is not encryption.
#   - A value already set in the real environment WINS over the value here.
#   - Blank values are ignored, so an unfilled placeholder leaves the key unset.
#
# Format:
#   KEY=value           # quotes are optional
#   KEY="with spaces"   # use quotes to keep leading/trailing spaces
#   # blank lines and lines starting with # are ignored

# ---- AI chat keys (widget.cs ChatWidget / utility.cs ChatProvider) ----------
# One key per provider, picked by the "ai-provider" setting (Settings > Preferences):
#   anthropic -> ANTHROPIC_API_KEY      openai -> OPENAI_API_KEY
#   ollama, lmstudio -> none needed, a loopback server ignores whatever is sent.
#
# The AI tab has a masked Key box that OVERRIDES whatever is here, for the session
# only - nothing typed there is written to disk. Use it for a one-off endpoint, e.g.
# pointing the openai provider at https://api.anthropic.com/v1/ (note the trailing
# /v1/ - without it the host returns 404) or at OpenRouter/Groq.
#
# A remote endpoint with no key from either source now fails immediately and names
# the variable to set, rather than sending a placeholder and getting a 401 back.

# Used by claude-test.cs — the Anthropic SDK reads this to authenticate.
ANTHROPIC_API_KEY=

# Used by the openai provider, and by any OpenAI-compatible URL you point it at.
OPENAI_API_KEY=

# Microsoft Entra app registration used by TeamsWidget and MailWidget (widget.cs)
TEAMS_CLIENT_ID=
# Required: your tenant GUID or domain (e.g. contoso.onmicrosoft.com)
TEAMS_TENANT_ID=

# Gmail, used by MailWidget when the "email-provider" user setting is "gmail".
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# GitHub, used by GitHistoryWidget (widget.cs) to list your recent pushes.
# GITHUB_USER is just your login and is not a secret. GITHUB_TOKEN IS a real secret:
# a classic or fine-grained PAT with read access.
GITHUB_USER=
GITHUB_TOKEN=

# NOTE: these two are for the CONTRIBUTION GRAPH only. The data sync (Settings >
# Preferences > Data sync) does NOT read any token from here - its credentials are
# encrypted under your passphrase in
#   %LOCALAPPDATA%\total-manager\credentials.json      (Windows)
#   ~/.local/share/total-manager/credentials.json   (Linux)
# which sits outside the synced folder on purpose, so a token is never pushed to a
# remote. You are asked for it the first time a sync needs it.

# Codeberg (Forgejo), used by GitHistoryWidget when the "git-provider" user setting is
# "codeberg". Pick the host on the Settings > Preferences page.
CODEBERG_USER=
CODEBERG_TOKEN=

BACKDROP_FILE=

# Freshdesk, used by FreshdeskWidget (widget.cs) to list your most recent tickets.
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=

# Linear, used by LinearWidget (widget.cs) to list the most recently created issues.
# A personal API key: Linear > Settings > Security & access > Personal API keys.
# It IS a real secret and carries your own account read access. Sent raw in the
# Authorization header - no "Bearer" prefix for personal keys.
LINEAR_API_KEY=
